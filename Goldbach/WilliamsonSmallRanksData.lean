/-- **Small ranks, certified.** No bad family of prime rank `5 ≤ P < 62` satisfies the
    previous-rank conditions (14566 candidate heights, each killed by a kernel-checked witness). -/
theorem small_ranks_clear : ∀ P p N, Nat.Prime P → 5 ≤ P → P < 62 →
    PreviousRankConditions p P N → ¬ BadFamily P N := by
  intro P p N hP h5 hlt hprc
  interval_cases P <;> first | exact rank5_clear p N hprc | exact rank7_clear p N hprc | exact rank11_clear p N hprc | exact rank13_clear p N hprc | exact rank17_clear p N hprc | exact rank19_clear p N hprc | exact rank23_clear p N hprc | exact rank29_clear p N hprc | exact rank31_clear p N hprc | exact rank37_clear p N hprc | exact rank41_clear p N hprc | exact rank43_clear p N hprc | exact rank47_clear p N hprc | exact rank53_clear p N hprc | exact rank59_clear p N hprc | exact rank61_clear p N hprc | exact absurd hP (by norm_num)

/-- **Goldbach from the two walls at threshold 62.** The small-rank hypothesis of
    `goldbach_of_walls_prev` is discharged by `small_ranks_clear`; `WallIAt 62` and
    `WallIIAt 62` remain open hypotheses. -/
theorem goldbach_of_walls_62 (hI : WallIAt 62) (hII : WallIIAt 62) :
    ∀ N, 8 ≤ N → Even N → GoldbachAt N :=
  goldbach_of_walls_prev 62 hI hII
    (fun P p N hP h5 hlt hprc _ => small_ranks_clear P p N hP h5 hlt hprc)

