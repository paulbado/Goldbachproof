theorem rank73_clear : ∀ p' N, PreviousRankConditions p' 73 N → ¬ BadFamily 73 N := by
  refine rank_clear_rows (p := 71) (a := 5) (fs := fs73) cert73
    (by decide +kernel) (by norm_num) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) ?_
