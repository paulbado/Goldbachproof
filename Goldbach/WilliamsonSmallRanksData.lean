import Goldbach.WilliamsonSmallRanks

/-! # Certified elimination of the prime ranks `5 ≤ P < 74`

Generated by `scripts/gen_small_rank_certificates.py`. For each rank `P` and row `ℓ`, the
candidate heights `N = ℓ + d` (`d ∣ prodF fs`, first-failure conditions) are listed by
`candsAt`, and each one is killed by a witness `(i, r)`: `r ≥ P` prime with `r ∣ N - i`.
The kernel checks every witness and the completeness of the enumeration (`rank_clear_rows`).
No native code evaluation is used (`decide +kernel` only). -/

namespace WilliamsonMurII

set_option maxRecDepth 100000

/-- Rank 5: previous prime 3; `deficitBudget 5 1 = 2^0 * prodF fs5`. -/
def fs5 : List (ℕ × ℕ) := []

def w5_3 : List (ℕ × ℕ) := []
theorem c5_3 : checkCert 5 (candsAt 5 3 fs5 3) w5_3 = true := by decide +kernel

def w5_5 : List (ℕ × ℕ) := []
theorem c5_5 : checkCert 5 (candsAt 5 3 fs5 5) w5_5 = true := by decide +kernel

/-- Row certificates of rank 5. -/
def cert5 : ℕ → List (ℕ × ℕ)
  | 3 => w5_3
  | 5 => w5_5
  | _ => []

theorem idx5 : idxList 5 = [3, 5] := by decide +kernel

theorem rank5_clear : ∀ p' N, PreviousRankConditions p' 5 N → ¬ BadFamily 5 N := by
  refine rank_clear_rows (p := 3) (a := 0) (fs := fs5) cert5
    (by decide +kernel) (by norm_num) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) ?_
  intro ℓ hℓ
  rw [idx5] at hℓ
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hℓ
  rcases hℓ with rfl | rfl
  exacts [c5_3, c5_5]

